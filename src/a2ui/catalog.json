{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
  "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
  "protocolVersion": "1.0",
  "title": "Radiant A2UI 1.0 Catalog",
  "description": "A2UI 1.0 catalog generated from Radiant registry entries backed by @cognitap/radiant/catalog.",
  "instructions": "Pick each component by intent; the host theme owns appearance.\n- Button runs actions and never navigates. Leave navigation to the host.\n- Bind input values to surface state; named actions receive a snapshot of that state.\n- Button `variant`: primary only for the main action, default for secondary actions, borderless for low emphasis such as Cancel.",
  "components": {
    "Column": {
      "description": "Arranges child elements vertically with semantic spacing and alignment.\nUse: Stacking sections, form fields or a card body top to bottom.\nAvoid: Side-by-side peers or data-driven repeats.\nExamples: form fields followed by a submit Button; heading and paragraph, `align: start`.",
      "type": "object",
      "properties": {
        "component": {
          "const": "Column"
        },
        "children": {
          "$ref": "common_types.json#/$defs/ChildList",
          "description": "Ordered vertical children."
        },
        "justify": {
          "type": "string",
          "enum": [
            "start",
            "center",
            "end",
            "spaceBetween",
            "spaceAround",
            "spaceEvenly",
            "stretch"
          ],
          "default": "start",
          "description": "Main-axis distribution of children."
        },
        "align": {
          "type": "string",
          "enum": ["start", "center", "end", "stretch"],
          "default": "stretch",
          "description": "Cross-axis alignment of children."
        },
        "weight": {
          "$ref": "#/$defs/Weight"
        }
      },
      "required": ["component", "children"]
    },
    "Text": {
      "description": "Displays formatted text with semantic typographic hierarchy.\nUse: Body copy and captions; `variant` picks between them.\nAvoid: Status messages or button labels.\nExamples: intro paragraph, `variant: body`; note under a form, `variant: caption`.",
      "type": "object",
      "properties": {
        "component": {
          "const": "Text"
        },
        "text": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "description": "Optional dynamic text value read from surface state."
        },
        "variant": {
          "type": "string",
          "enum": ["caption", "body"],
          "default": "body",
          "description": "Semantic typographic hierarchy."
        },
        "weight": {
          "$ref": "#/$defs/Weight"
        }
      },
      "required": ["component", "text"]
    },
    "TextField": {
      "type": "object",
      "description": "Collects single-line or multi-line text input with label, description, and validation.\nUse: Free text: names, numbers or passwords; `variant: longText` for paragraphs.\nAvoid: Known options (ChoicePicker), dates (DateTimeInput) or an approximate number in a range (Slider).\nExamples: password, `variant: obscured`; feedback, `variant: longText`.",
      "allOf": [
        {
          "$ref": "common_types.json#/$defs/Checkable"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "TextField"
            },
            "label": {
              "$ref": "common_types.json#/$defs/DynamicString",
              "description": "Visible field label."
            },
            "value": {
              "$ref": "common_types.json#/$defs/DynamicString",
              "description": "Current text value bound to surface state."
            },
            "placeholder": {
              "$ref": "common_types.json#/$defs/DynamicString",
              "description": "Example value shown when empty."
            },
            "variant": {
              "type": "string",
              "enum": ["longText", "number", "shortText", "obscured"],
              "default": "shortText",
              "description": "Input intent controlling native input type or multiline textarea."
            },
            "weight": {
              "$ref": "#/$defs/Weight"
            }
          },
          "required": ["component", "label", "value"]
        }
      ]
    },
    "CheckBox": {
      "type": "object",
      "description": "Collects an explicit boolean consent or selection state.\nUse: An independent yes/no choice submitted later, such as consent.\nAvoid: One of several options (ChoicePicker).\nExamples: accept the terms; email me product updates.",
      "allOf": [
        {
          "$ref": "common_types.json#/$defs/Checkable"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "CheckBox"
            },
            "label": {
              "$ref": "common_types.json#/$defs/DynamicString",
              "description": "Visible checkbox label."
            },
            "value": {
              "$ref": "common_types.json#/$defs/DynamicBoolean",
              "description": "Checked state bound to surface state."
            },
            "weight": {
              "$ref": "#/$defs/Weight"
            }
          },
          "required": ["component", "label", "value"]
        }
      ]
    },
    "ChoicePicker": {
      "type": "object",
      "description": "Selects one or multiple values from curated options using an intent-based presentation.\nUse: Known options. `displayStyle: chips` suits tags; `filterable: true` suits long lists.\nAvoid: Free text (TextField), a single yes/no (CheckBox) or switching views.\nExamples: toppings, `variant: multipleSelection`, `displayStyle: chips`; country, `variant: mutuallyExclusive`, `filterable: true`.",
      "allOf": [
        {
          "$ref": "common_types.json#/$defs/Checkable"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "ChoicePicker"
            },
            "label": {
              "$ref": "common_types.json#/$defs/DynamicString",
              "description": "Visible field or group label."
            },
            "variant": {
              "type": "string",
              "enum": ["multipleSelection", "mutuallyExclusive"],
              "default": "mutuallyExclusive",
              "description": "Whether one or multiple options can be selected."
            },
            "options": {
              "type": "array",
              "description": "Selectable choices presented to the user.",
              "items": {
                "type": "object",
                "properties": {
                  "label": {
                    "$ref": "common_types.json#/$defs/DynamicString"
                  },
                  "value": {
                    "type": "string"
                  }
                },
                "required": ["label", "value"],
                "additionalProperties": false
              }
            },
            "value": {
              "$ref": "common_types.json#/$defs/DynamicStringList",
              "description": "Selected option value or values bound to surface state."
            },
            "displayStyle": {
              "type": "string",
              "enum": ["checkbox", "chips"],
              "default": "checkbox",
              "description": "Visual presentation intent for the choice control."
            },
            "filterable": {
              "type": "boolean",
              "default": false,
              "description": "Enables filtering options by typing when presented as a dropdown."
            },
            "weight": {
              "$ref": "#/$defs/Weight"
            }
          },
          "required": ["component", "options", "value"]
        }
      ]
    },
    "Slider": {
      "type": "object",
      "description": "Selects a numeric value within a bounded range.\nUse: An approximate number in a bounded range where relative position matters.\nAvoid: Exact values (TextField) or a few discrete options (ChoicePicker).\nExamples: volume, `min: 0`, `max: 100`; budget in steps of 100, `min: 500`, `max: 5000`, `steps: 45`.",
      "allOf": [
        {
          "$ref": "common_types.json#/$defs/Checkable"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "Slider"
            },
            "label": {
              "$ref": "common_types.json#/$defs/DynamicString",
              "description": "Visible slider label."
            },
            "min": {
              "type": "number",
              "description": "Minimum allowed value.",
              "default": 0
            },
            "max": {
              "type": "number",
              "description": "Maximum allowed value."
            },
            "value": {
              "$ref": "common_types.json#/$defs/DynamicNumber",
              "description": "Current numeric value bound to surface state."
            },
            "steps": {
              "type": "integer",
              "minimum": 1,
              "description": "Number of discrete divisions; the renderer derives the canonical step size."
            },
            "weight": {
              "$ref": "#/$defs/Weight"
            }
          },
          "required": ["component", "value", "max"]
        }
      ]
    },
    "Button": {
      "type": "object",
      "description": "Triggers a client-local update or emits a named outbound action.\nUse: An action: submit, save, start, or emit a named `action`.\nAvoid: Navigation; Button never renders a link. Picking options (ChoicePicker).\nExamples: Save changes, `variant: primary`; Cancel beside it, `variant: borderless`.",
      "allOf": [
        {
          "$ref": "common_types.json#/$defs/Checkable"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "Button"
            },
            "child": {
              "$ref": "common_types.json#/$defs/Child",
              "description": "Optional rich content inside the button."
            },
            "variant": {
              "type": "string",
              "enum": ["default", "primary", "borderless"],
              "default": "default",
              "description": "Visual treatment of the button."
            },
            "action": {
              "$ref": "common_types.json#/$defs/Action",
              "description": "Action dispatched when the user activates the button."
            },
            "weight": {
              "$ref": "#/$defs/Weight"
            }
          },
          "required": ["component", "child", "action"]
        }
      ]
    },
    "Icon": {
      "description": "Displays a named vector icon from the host icon registry.\nUse: A standard icon that adds meaning beside text.\nAvoid: Photos or illustrations (Image), or meaning the icon alone must carry.\nExamples: warning glyph before a note, `name: warning`; download action, `name: download`, inside a Button.",
      "type": "object",
      "properties": {
        "component": {
          "const": "Icon"
        },
        "name": {
          "description": "A2UI icon name, custom SVG path, or bound icon name.",
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "accountCircle",
                "add",
                "arrowBack",
                "arrowForward",
                "attachFile",
                "calendarToday",
                "call",
                "camera",
                "check",
                "close",
                "delete",
                "download",
                "edit",
                "event",
                "error",
                "fastForward",
                "favorite",
                "favoriteOff",
                "folder",
                "help",
                "home",
                "info",
                "locationOn",
                "lock",
                "lockOpen",
                "mail",
                "menu",
                "moreVert",
                "moreHoriz",
                "notificationsOff",
                "notifications",
                "pause",
                "payment",
                "person",
                "phone",
                "photo",
                "play",
                "print",
                "refresh",
                "rewind",
                "search",
                "send",
                "settings",
                "share",
                "shoppingCart",
                "skipNext",
                "skipPrevious",
                "star",
                "starHalf",
                "starOff",
                "stop",
                "upload",
                "visibility",
                "visibilityOff",
                "volumeDown",
                "volumeMute",
                "volumeOff",
                "volumeUp",
                "warning"
              ]
            },
            {
              "type": "object",
              "properties": {
                "svgPath": {
                  "$ref": "common_types.json#/$defs/DynamicString"
                }
              },
              "required": ["svgPath"],
              "additionalProperties": false
            },
            {
              "$ref": "common_types.json#/$defs/DataBinding"
            }
          ]
        },
        "weight": {
          "$ref": "#/$defs/Weight"
        }
      },
      "required": ["component", "name"]
    },
    "Image": {
      "description": "Displays an image with explicit alternative text and aspect behavior.\nUse: Photos, illustrations and avatars. Set `variant` for size intent and `description` for meaning.\nAvoid: Standard icons (Icon). Leave `description` empty only for decoration.\nExamples: product photo, `variant: mediumFeature`, `fit: cover`; profile picture, `variant: avatar`, `description` naming the person.",
      "type": "object",
      "properties": {
        "component": {
          "const": "Image"
        },
        "url": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "description": "Optional reactive image URL from surface state."
        },
        "description": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "description": "Alternative text describing the image, or empty string if decorative."
        },
        "fit": {
          "type": "string",
          "enum": ["contain", "cover", "fill", "none", "scaleDown"],
          "default": "fill",
          "description": "How the image fits inside its frame."
        },
        "variant": {
          "type": "string",
          "enum": ["icon", "avatar", "smallFeature", "mediumFeature", "largeFeature", "header"],
          "default": "mediumFeature",
          "description": "Semantic presentation size hint."
        },
        "weight": {
          "$ref": "#/$defs/Weight"
        }
      },
      "required": ["component", "url"]
    },
    "Video": {
      "description": "Plays a video clip with native browser controls.\nUse: A video clip the user starts.\nAvoid: Still images (Image), audio only (AudioPlayer) or decorative motion.\nExamples: product walkthrough with a `posterUrl` frame; recorded lecture clip.",
      "type": "object",
      "properties": {
        "component": {
          "const": "Video"
        },
        "url": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "description": "Optional reactive video URL from surface state."
        },
        "posterUrl": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "description": "Optional poster frame image URL."
        },
        "weight": {
          "$ref": "#/$defs/Weight"
        }
      },
      "required": ["component", "url"]
    },
    "AudioPlayer": {
      "description": "Plays an audio track with native browser controls.\nUse: An audio track such as a podcast or voice note; `description` says what it is.\nAvoid: Video (Video) or sounds tied to actions.\nExamples: podcast episode with a `description`; pronunciation sample of one word.",
      "type": "object",
      "properties": {
        "component": {
          "const": "AudioPlayer"
        },
        "url": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "description": "Optional reactive audio URL from surface state."
        },
        "description": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "description": "Optional description of the audio."
        },
        "weight": {
          "$ref": "#/$defs/Weight"
        }
      },
      "required": ["component", "url"]
    },
    "DateTimeInput": {
      "type": "object",
      "description": "Collects a calendar date, wall-clock time, or combined date and time.\nUse: A calendar date, a time, or both; set `enableDate` and `enableTime`.\nAvoid: Durations or free text (TextField), or relative picks such as this week (ChoicePicker).\nExamples: delivery date, `enableDate: true`, with a `min` bound; meeting start, `enableDate: true`, `enableTime: true`.",
      "allOf": [
        {
          "$ref": "common_types.json#/$defs/Checkable"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "DateTimeInput"
            },
            "value": {
              "$ref": "common_types.json#/$defs/DynamicString",
              "description": "ISO 8601 date or date-time string bound to surface state."
            },
            "enableDate": {
              "type": "boolean",
              "default": false,
              "description": "Includes a date component."
            },
            "enableTime": {
              "type": "boolean",
              "default": false,
              "description": "Includes a time component."
            },
            "min": {
              "description": "Minimum allowed ISO 8601 date or time.",
              "allOf": [
                {
                  "$ref": "common_types.json#/$defs/DynamicString"
                },
                {
                  "if": {
                    "type": "string"
                  },
                  "then": {
                    "oneOf": [
                      {
                        "format": "date"
                      },
                      {
                        "format": "time"
                      },
                      {
                        "format": "date-time"
                      }
                    ]
                  }
                }
              ]
            },
            "max": {
              "description": "Maximum allowed ISO 8601 date or time.",
              "allOf": [
                {
                  "$ref": "common_types.json#/$defs/DynamicString"
                },
                {
                  "if": {
                    "type": "string"
                  },
                  "then": {
                    "oneOf": [
                      {
                        "format": "date"
                      },
                      {
                        "format": "time"
                      },
                      {
                        "format": "date-time"
                      }
                    ]
                  }
                }
              ]
            },
            "label": {
              "$ref": "common_types.json#/$defs/DynamicString",
              "description": "Visible field label."
            },
            "weight": {
              "$ref": "#/$defs/Weight"
            }
          },
          "required": ["component", "value"]
        }
      ]
    }
  },
  "functions": {
    "required": {
      "type": "object",
      "description": "Checks that the value is not null, undefined, or empty.",
      "returnType": "validationResult",
      "properties": {
        "@call": {
          "const": "required"
        },
        "args": {
          "type": "object",
          "properties": {
            "value": {
              "description": "The value to check."
            }
          },
          "required": ["value"],
          "unevaluatedProperties": false
        }
      },
      "required": ["@call", "args"]
    },
    "regex": {
      "type": "object",
      "description": "Checks that the value matches a regular expression string.",
      "returnType": "validationResult",
      "properties": {
        "@call": {
          "const": "regex"
        },
        "args": {
          "type": "object",
          "properties": {
            "value": {
              "$ref": "common_types.json#/$defs/DynamicString"
            },
            "pattern": {
              "type": "string",
              "description": "The regex pattern to match against."
            }
          },
          "required": ["value", "pattern"],
          "unevaluatedProperties": false
        }
      },
      "required": ["@call", "args"]
    },
    "length": {
      "type": "object",
      "description": "Checks string length constraints.",
      "returnType": "validationResult",
      "properties": {
        "@call": {
          "const": "length"
        },
        "args": {
          "type": "object",
          "properties": {
            "value": {
              "$ref": "common_types.json#/$defs/DynamicString"
            },
            "min": {
              "type": "integer",
              "minimum": 0,
              "description": "The minimum allowed length."
            },
            "max": {
              "type": "integer",
              "minimum": 0,
              "description": "The maximum allowed length."
            }
          },
          "required": ["value"],
          "unevaluatedProperties": false,
          "anyOf": [
            {
              "required": ["min"]
            },
            {
              "required": ["max"]
            }
          ]
        }
      },
      "required": ["@call", "args"]
    },
    "numeric": {
      "type": "object",
      "description": "Checks numeric range constraints.",
      "returnType": "validationResult",
      "properties": {
        "@call": {
          "const": "numeric"
        },
        "args": {
          "type": "object",
          "properties": {
            "value": {
              "$ref": "common_types.json#/$defs/DynamicNumber"
            },
            "min": {
              "type": "number",
              "description": "The minimum allowed value."
            },
            "max": {
              "type": "number",
              "description": "The maximum allowed value."
            }
          },
          "required": ["value"],
          "unevaluatedProperties": false,
          "anyOf": [
            {
              "required": ["min"]
            },
            {
              "required": ["max"]
            }
          ]
        }
      },
      "required": ["@call", "args"]
    },
    "email": {
      "type": "object",
      "description": "Checks that the value is a valid email address.",
      "returnType": "validationResult",
      "properties": {
        "@call": {
          "const": "email"
        },
        "args": {
          "type": "object",
          "properties": {
            "value": {
              "$ref": "common_types.json#/$defs/DynamicString"
            }
          },
          "required": ["value"],
          "unevaluatedProperties": false
        }
      },
      "required": ["@call", "args"]
    },
    "formatString": {
      "type": "object",
      "description": "Performs string interpolation of data model values and other functions in the catalog functions list and returns the resulting string. The value string can contain interpolated expressions in the `${expression}` format. Supported expression types include: JSON Pointer paths to the data model (e.g., `${/absolute/path}` or `${relative/path}`), and renderer-side function calls (e.g., `${now()}`). Function arguments must be named (e.g., `${formatDate(value:${/currentDate}, format:'MM-dd')}`). To include a literal `${` sequence, escape it as `\\${`.",
      "returnType": "string",
      "properties": {
        "@call": {
          "const": "formatString"
        },
        "args": {
          "type": "object",
          "properties": {
            "value": {
              "$ref": "common_types.json#/$defs/DynamicString"
            }
          },
          "required": ["value"],
          "unevaluatedProperties": false
        }
      },
      "required": ["@call", "args"]
    },
    "formatNumber": {
      "type": "object",
      "description": "Formats a number with the specified grouping and decimal precision.",
      "returnType": "string",
      "properties": {
        "@call": {
          "const": "formatNumber"
        },
        "args": {
          "type": "object",
          "properties": {
            "value": {
              "$ref": "common_types.json#/$defs/DynamicNumber",
              "description": "The number to format."
            },
            "decimals": {
              "$ref": "common_types.json#/$defs/DynamicNumber",
              "description": "Optional. The number of decimal places to show. Defaults to 0 or 2 depending on locale."
            },
            "grouping": {
              "$ref": "common_types.json#/$defs/DynamicBoolean",
              "description": "Optional. If true, uses locale-specific grouping separators (e.g. '1,000'). If false, returns raw digits (e.g. '1000'). Defaults to true."
            }
          },
          "required": ["value"],
          "unevaluatedProperties": false
        }
      },
      "required": ["@call", "args"]
    },
    "formatCurrency": {
      "type": "object",
      "description": "Formats a number as a currency string.",
      "returnType": "string",
      "properties": {
        "@call": {
          "const": "formatCurrency"
        },
        "args": {
          "type": "object",
          "properties": {
            "value": {
              "$ref": "common_types.json#/$defs/DynamicNumber",
              "description": "The monetary amount."
            },
            "currency": {
              "$ref": "common_types.json#/$defs/DynamicString",
              "description": "The ISO 4217 currency code (e.g., 'USD', 'EUR')."
            },
            "decimals": {
              "$ref": "common_types.json#/$defs/DynamicNumber",
              "description": "Optional. The number of decimal places to show. Defaults to 0 or 2 depending on locale."
            },
            "grouping": {
              "$ref": "common_types.json#/$defs/DynamicBoolean",
              "description": "Optional. If true, uses locale-specific grouping separators (e.g. '1,000'). If false, returns raw digits (e.g. '1000'). Defaults to true."
            }
          },
          "required": ["currency", "value"],
          "unevaluatedProperties": false
        }
      },
      "required": ["@call", "args"]
    },
    "formatDate": {
      "type": "object",
      "description": "Formats a timestamp into a string using a pattern.",
      "returnType": "string",
      "properties": {
        "@call": {
          "const": "formatDate"
        },
        "args": {
          "type": "object",
          "properties": {
            "value": {
              "$ref": "common_types.json#/$defs/DynamicValue",
              "description": "The date to format."
            },
            "format": {
              "$ref": "common_types.json#/$defs/DynamicString",
              "description": "A Unicode TR35 date pattern string.\n\nToken Reference:\n- Year: 'yy' (26), 'yyyy' (2026)\n- Month: 'M' (1), 'MM' (01), 'MMM' (Jan), 'MMMM' (January)\n- Day: 'd' (1), 'dd' (01), 'E' (Tue), 'EEEE' (Tuesday)\n- Hour (12h): 'h' (1-12), 'hh' (01-12) - requires 'a' for AM/PM\n- Hour (24h): 'H' (0-23), 'HH' (00-23) - Military Time\n- Minute: 'mm' (00-59)\n- Second: 'ss' (00-59)\n- Period: 'a' (AM/PM)\n\nExamples:\n- 'MMM dd, yyyy' -> 'Jan 16, 2026'\n- 'HH:mm' -> '14:30' (Military)\n- 'h:mm a' -> '2:30 PM'\n- 'EEEE, d MMMM' -> 'Friday, 16 January'"
            }
          },
          "required": ["format", "value"],
          "unevaluatedProperties": false
        }
      },
