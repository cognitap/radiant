{
  "name": "@cognitap/radiant",
  "version": "0.1.0",
  "private": true,
  "description": "React interaction components and presentation primitives",
  "homepage": "https://github.com/cognitap/radiant#readme",
  "bugs": {
    "url": "https://github.com/cognitap/radiant/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cognitap/radiant.git"
  },
  "files": [
    "LICENSE",
    "CHANGELOG.md",
    "RELEASE_POLICY.md",
    "dist/library",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/styles.css",
    "!src/**/*.stories.*",
    "!src/**/*.test.*"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/library/index.d.ts",
      "default": "./dist/library/index.js"
    },
    "./styles.css": "./dist/library/styles.css",
    "./reset.css": "./dist/library/reset.css",
    "./tailwind.css": "./src/styles.css"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  },
  "scripts": {
    "prepare": "husky",
    "storybook": "storybook dev --host 127.0.0.1 --port 6006 --no-open --disable-telemetry",
    "build": "rimraf dist/library && pnpm build:js && pnpm build:css",
    "build:js": "tsc -p tsconfig.build.json",
    "build:css": "tailwindcss -i styles/library.css -o dist/library/styles.css --minify && tailwindcss -i styles/reset.css -o dist/library/reset.css --minify",
    "watch": "pnpm run --parallel '/^watch:/'",
    "watch:js": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "watch:styles": "tailwindcss -i styles/library.css -o dist/library/styles.css --watch=always",
    "build:storybook": "storybook build --output-dir dist/storybook --disable-telemetry",
    "test": "pnpm build && node --test tests/*.test.mjs && tsc -p tests/tsconfig.json && tsc -p tests/tsconfig.json --module ESNext --moduleResolution Bundler && node tests/archive.mjs",
    "test:archive": "pnpm build && node tests/archive.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "pnpm fmt:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build:storybook"
  },
  "dependencies": {
    "cn": "0.4.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@tailwindcss/cli": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rimraf": "6.1.3",
    "storybook": "10.6.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "tailwindcss": "^4.3.3"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.11.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.11.2"
}
