{
  "name": "@cognitap/radiant",
  "version": "0.0.40",
  "description": "React interaction components and presentation primitives",
  "homepage": "https://radiant-docs.pages.dev",
  "bugs": {
    "url": "https://github.com/cognitap/radiant/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cognitap/radiant.git"
  },
  "files": [
    "LICENSE",
    "CHANGELOG.md",
    "RELEASE_POLICY.md",
    "docs/architecture.md",
    "docs/motion.md",
    "docs/accessibility.md",
    "docs/theming.md",
    "dist/library",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/styles.css",
    "src/themes/baseline.css",
    "!src/**/*.stories.*",
    "!src/**/*.test.*",
    "src/typography.css"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/library/index.d.ts",
      "default": "./dist/library/index.js"
    },
    "./styles.css": "./dist/library/styles.css",
    "./reset.css": "./dist/library/reset.css",
    "./tailwind.css": "./src/styles.css",
    "./color": {
      "types": "./dist/library/color/index.d.ts",
      "default": "./dist/library/color/index.js"
    },
    "./typography": {
      "types": "./dist/library/typography/index.d.ts",
      "default": "./dist/library/typography/index.js"
    },
    "./examples": {
      "types": "./dist/library/examples/index.d.ts",
      "default": "./dist/library/examples/index.js"
    },
    "./motion": {
      "types": "./dist/library/motion/index.d.ts",
      "default": "./dist/library/motion/index.js"
    },
    "./motion/react": {
      "types": "./dist/library/motion/react.d.ts",
      "default": "./dist/library/motion/react.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  },
  "scripts": {
    "prepare": "husky",
    "storybook": "pnpm theme:generate && storybook dev --host 127.0.0.1 --port 6006 --no-open --disable-telemetry",
    "build": "rimraf dist/library && pnpm build:js && pnpm build:css",
    "build:js": "tsc -p tsconfig.build.json",
    "build:css": "pnpm theme:generate && tailwindcss -i styles/library.css -o dist/library/styles.css --minify && tailwindcss -i styles/reset.css -o dist/library/reset.css --minify && node scripts/preserve-css-layer-order.mjs",
    "watch": "pnpm run --parallel '/^watch:/'",
    "watch:js": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "watch:styles": "pnpm theme:generate && tailwindcss -i styles/library.css -o dist/library/styles.css --watch=always",
    "build:storybook": "pnpm theme:generate && storybook build --output-dir dist/storybook --disable-telemetry",
    "test": "pnpm build && node --test tests/*.test.mjs && node scripts/pack-and-test.ts",
    "test:package": "pnpm build && node scripts/pack-and-test.ts",
    "typecheck": "pnpm build:js && tsc --noEmit && pnpm typecheck:contracts",
    "typecheck:contracts": "tsc -p docs/contracts/tsconfig.json",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check:source": "pnpm theme:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm docs:check",
    "docs:check": "node scripts/check-docs.mjs",
    "check": "pnpm check:source && pnpm build && node --test tests/*.test.mjs && node scripts/pack-and-test.ts && pnpm build:storybook && pnpm test:browser --project=storybook-radiant-light --project=storybook-radiant-dark",
    "release:prepare": "node scripts/prepare-release.mjs",
    "theme:generate": "node scripts/generate-theme-css.mjs",
    "theme:check": "node scripts/generate-theme-css.mjs --check",
    "watch:theme": "node scripts/generate-theme-css.mjs --watch",
    "test:browser": "pnpm theme:generate && vitest run"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "motion": "14.7.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/addon-vitest": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@tailwindcss/cli": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-form": "1.33.5",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser-playwright": "5.0.5",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "playwright": "1.64.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rimraf": "6.1.3",
    "storybook": "10.6.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "tailwindcss": "^4.3.3"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.11.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.11.2"
}
