{
  "name": "@cognitap/radiant",
  "version": "0.0.104",
  "description": "React interaction components and presentation primitives",
  "homepage": "https://radiant-docs.pages.dev",
  "bugs": {
    "url": "https://github.com/cognitap/radiant/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cognitap/radiant.git"
  },
  "files": [
    "LICENSE",
    "CHANGELOG.md",
    "RELEASE_POLICY.md",
    "docs/architecture.md",
    "docs/motion.md",
    "docs/accessibility.md",
    "docs/theming.md",
    "dist/library",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/a2ui/catalog.json",
    "src/a2ui/extension-catalog.json",
    "src/styles.css",
    "src/themes/baseline.css",
    "!src/**/*.stories.*",
    "!src/**/*.test.*",
    "src/typography.css"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/library/index.d.ts",
      "default": "./dist/library/index.js"
    },
    "./styles.css": {
      "types": "./src/css.d.ts",
      "default": "./dist/library/styles.css"
    },
    "./reset.css": {
      "types": "./src/css.d.ts",
      "default": "./dist/library/reset.css"
    },
    "./tailwind.css": "./src/styles.css",
    "./color": {
      "types": "./dist/library/color/index.d.ts",
      "default": "./dist/library/color/index.js"
    },
    "./typography": {
      "types": "./dist/library/typography/index.d.ts",
      "default": "./dist/library/typography/index.js"
    },
    "./examples": {
      "types": "./dist/library/examples/index.d.ts",
      "default": "./dist/library/examples/index.js"
    },
    "./motion": {
      "types": "./dist/library/motion/index.d.ts",
      "default": "./dist/library/motion/index.js"
    },
    "./motion/react": {
      "types": "./dist/library/motion/react.d.ts",
      "default": "./dist/library/motion/react.js"
    },
    "./charts": {
      "types": "./dist/library/charts/index.d.ts",
      "default": "./dist/library/charts/index.js"
    },
    "./catalog": {
      "types": "./dist/library/catalog/index.d.ts",
      "default": "./dist/library/catalog/index.js"
    },
    "./a2ui": {
      "types": "./dist/library/a2ui/index.d.ts",
      "default": "./dist/library/a2ui/index.js"
    },
    "./a2ui/catalog.json": "./src/a2ui/catalog.json",
    "./a2ui/extension-catalog.json": "./src/a2ui/extension-catalog.json",
    "./a2ui/lucide": {
      "types": "./dist/library/a2ui/lucide.d.ts",
      "default": "./dist/library/a2ui/lucide.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  },
  "scripts": {
    "prepare": "husky",
    "storybook": "pnpm theme:generate && storybook dev --host 127.0.0.1 --port 6006 --disable-telemetry",
    "build": "pnpm build:js && pnpm build:css && node scripts/prune-dist.ts",
    "build:js": "tsc -p tsconfig.build.json",
    "build:css": "pnpm theme:generate && tailwindcss -i styles/library.css -o dist/library/styles.css --minify && tailwindcss -i styles/reset.css -o dist/library/reset.css --minify && node scripts/preserve-css-layer-order.ts",
    "watch": "pnpm run --parallel '/^watch:/'",
    "watch:js": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "watch:styles": "pnpm theme:generate && tailwindcss -i styles/library.css -o dist/library/styles.css --watch=always",
    "build:storybook": "pnpm theme:generate && storybook build --output-dir dist/storybook --disable-telemetry",
    "test": "pnpm build && node --test tests/*.test.mjs && node scripts/pack-and-test.ts",
    "test:package": "pnpm build && node scripts/pack-and-test.ts",
    "typecheck": "pnpm build:js && tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "docs:check": "node scripts/check-docs.ts",
    "check": "pnpm check:library && pnpm check:storybook && pnpm check:conformance",
    "check:library": "pnpm theme:check && pnpm format:check && pnpm lint && pnpm build && pnpm catalog:check && tsc --noEmit && pnpm docs:check && node --test tests/*.test.mjs && node scripts/pack-and-test.ts",
    "check:storybook": "pnpm build:storybook && pnpm test:browser --project=storybook-radiant-light --project=storybook-radiant-dark",
    "check:conformance": "pnpm test:browser --project='storybook-*' --project='!storybook-radiant-*' src/a2ui/A2uiConformance.stories.tsx",
    "release:prepare": "node scripts/prepare-release.ts",
    "catalog:generate": "node scripts/generate-a2ui-functions.ts && pnpm build:js && node scripts/generate-a2ui-catalog.ts",
    "catalog:check": "node scripts/generate-a2ui-functions.ts --check && node scripts/generate-a2ui-catalog.ts --check",
    "theme:generate": "node scripts/generate-theme-css.ts",
    "theme:check": "node scripts/generate-theme-css.ts --check",
    "watch:theme": "node scripts/generate-theme-css.ts --watch",
    "test:browser": "pnpm theme:generate && vitest run",
    "test:visual": "pnpm theme:generate && vitest run --project=visual"
  },
  "dependencies": {
    "@a2ui/web_core": "0.15.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "motion": "14.7.1"
  },
  "devDependencies": {
    "@cognitap/galactica": "0.2.3",
    "@fontsource-variable/inter": "5.3.0",
    "@storybook/addon-a11y": "11.0.0-rc.0",
    "@storybook/addon-docs": "11.0.0-rc.0",
    "@storybook/addon-vitest": "11.0.0-rc.0",
    "@storybook/react-vite": "11.0.0-rc.0",
    "@tailwindcss/cli": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-form": "1.33.5",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser-playwright": "5.0.5",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "lucide-react": "1.77.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "playwright": "1.64.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "storybook": "11.0.0-rc.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "lucide-react": "^1.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3"
  },
  "peerDependenciesMeta": {
    "lucide-react": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    }
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.11.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.11.2"
}
